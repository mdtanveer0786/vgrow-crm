# ── Server ──
PORT=5000
NODE_ENV=development

# ── Database ──
# Option 1: Connection URL (preferred)
DATABASE_URL=mysql://root:YOUR_PASSWORD@localhost:3306/vgrow

# Option 2: Individual vars (fallback if DATABASE_URL not set)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vgrow
DB_USER=root
DB_PASSWORD=YOUR_PASSWORD

# ── Authentication ──
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=30d

# ── CORS ──
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ── WhatsApp (Meta Cloud API) ──
META_WHATSAPP_API_TOKEN=your_meta_api_token
META_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# ── Razorpay ──
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Twilio (Telephony) ──
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# ── AI (Optional) ──
OPENAI_API_KEY=your_openai_api_key
